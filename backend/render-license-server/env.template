# AutoJMS Render license server environment.
# Copy to .env for local development only. Do not commit .env or real secrets.

PORT=3000
FIREBASE_OPERATION_TIMEOUT_MS=8000

# RS256 JWT keys. Use PEM text. Escaped \n is accepted by server.js.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Firebase Realtime Database.
FIREBASE_DATABASE_URL=https://keyauthjms-default-rtdb.asia-southeast1.firebasedatabase.app/

# Choose exactly one Firebase credential source.
# Render production should use FIREBASE_SERVICE_ACCOUNT_BASE64 unless you explicitly deploy another source:
# 1. Base64 encoded JSON:
FIREBASE_SERVICE_ACCOUNT_BASE64=
# 2. JSON string:
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3. Local file path:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# DataHub runtime config returned to the desktop client.
DATAHUB_API_BASE_URL=https://datahub.example.com

# DataHub device-enrollment assertion (RS256). Without the private key this server issues no
# assertion and the DataHub API refuses every /api/v1/devices/enroll call, so the desktop app
# runs offline-only. Generate the pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out datahub-license.key
#   openssl rsa -in datahub-license.key -pubout -out datahub-license.pub
# The PRIVATE half belongs here; the PUBLIC half goes to the VPS as
# DataHub__LicenseAssertion__PublicKeyPem. Never commit either file.
DATAHUB_LICENSE_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Must match DataHub__LicenseAssertion__Issuer / __Audience on the VPS.
DATAHUB_LICENSE_ASSERTION_ISSUER=autojms-license
DATAHUB_LICENSE_ASSERTION_AUDIENCE=autojms-datahub-enroll
# Assertion lifetime in seconds (clamped to 60..3600). Short on purpose: it is only ever used
# once, immediately, to trade for a device token.
DATAHUB_LICENSE_ASSERTION_TTL_SECONDS=300
# Must match DataHub__Channel on the VPS: staging or production.
DATAHUB_CHANNEL=production
# Seat cap for licenses that carry no explicit `seats` field in Firebase (clamped to 1..500).
DATAHUB_DEFAULT_SEATS=3

# Google Sheets token broker. Render production should provide this as a Secret File.
# If omitted, the server falls back to FIREBASE_SERVICE_ACCOUNT_FILE.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/etc/secrets/googleSheetsServiceAccount.json
GOOGLE_SHEETS_GRANT_TIMEOUT_MS=8000

DEFAULT_UPDATE_CHANNEL=stable
VALID_EXE_HASHES=
