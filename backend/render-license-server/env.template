# AutoJMS Render license server environment.
# Copy to .env for local development only. Do not commit .env or real secrets.

PORT=3000
FIREBASE_OPERATION_TIMEOUT_MS=8000

# RS256 JWT keys. Use PEM text. Escaped \n is accepted by server.js.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Firebase Realtime Database.
FIREBASE_DATABASE_URL=https://keyauthjms-default-rtdb.asia-southeast1.firebasedatabase.app/

# Choose exactly one Firebase credential source. They are tried in this order, and the
# first one that is set must be usable — a present-but-malformed source is a hard error,
# not a fall-through, so a typo cannot be reported as "no credentials configured".
# Render production should use FIREBASE_SERVICE_ACCOUNT_BASE64 unless you explicitly deploy another source:
# 1. JSON string:
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2. Base64 encoded JSON:
FIREBASE_SERVICE_ACCOUNT_BASE64=
# 3. Explicit file path. This is the one to use with a Render Secret File, which is
#    mounted under whatever name it was given and frequently has no .json extension.
#    It doubles as the Google Sheets broker's fallback (see below), so on a deployment
#    that already sets it, no other credential variable is needed.
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebaseServiceAccount.json
# 4. Conventional ADC path:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# If none of the four is set, ./serviceAccountKey.json next to server.js is the last
# resort; if that is missing too, the process exits on boot.

# DataHub runtime config returned to the desktop client.
DATAHUB_API_BASE_URL=https://datahub.example.com

# DataHub device-enrollment assertion (RS256). Without the private key this server issues no
# assertion and the DataHub API refuses every /api/v1/devices/enroll call, so the desktop app
# runs offline-only. Generate the pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out datahub-license.key
#   openssl rsa -in datahub-license.key -pubout -out datahub-license.pub
# The PRIVATE half belongs here; the PUBLIC half goes to the VPS as
# DataHub__LicenseAssertion__PublicKeyPem. Never commit either file.
DATAHUB_LICENSE_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Must match DATAHUB_LICENSE_ASSERTION_ISSUER / _AUDIENCE on the VPS exactly. These are the
# values in backend/datahub/env.production.template; staging uses the -staging suffix.
# Leaving them unset falls back to the unsuffixed "autojms-license" /
# "autojms-datahub-enroll", which match NEITHER template and fail every enrollment.
DATAHUB_LICENSE_ASSERTION_ISSUER=autojms-license-production
DATAHUB_LICENSE_ASSERTION_AUDIENCE=autojms-datahub-enroll-production
# Assertion lifetime in seconds (clamped to 60..3600). Short on purpose: it is only ever used
# once, immediately, to trade for a device token.
DATAHUB_LICENSE_ASSERTION_TTL_SECONDS=300
# Must match DataHub__Channel on the VPS: staging or production.
DATAHUB_CHANNEL=production
# Seat cap for licenses that carry no explicit `seats` field in Firebase (clamped to 1..500).
DATAHUB_DEFAULT_SEATS=3

# Google Sheets token broker. Render production should provide this as a Secret File.
# If omitted, the server falls back to FIREBASE_SERVICE_ACCOUNT_FILE.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/etc/secrets/googleSheetsServiceAccount.json
GOOGLE_SHEETS_GRANT_TIMEOUT_MS=8000

DEFAULT_UPDATE_CHANNEL=stable
# Comma-separated SHA-256 hashes of the executables allowed to activate. EMPTY DISABLES
# THE CHECK FOR THE WHOLE FLEET — every key that did not set skipHashCheck is then
# verified against nothing. That is a legitimate state during a release, so it is
# allowed, but each activation that takes it logs license.hash_check_skipped_empty_env
# so "integrity is on" and "integrity is configured off" are distinguishable afterwards.
VALID_EXE_HASHES=

# License lifecycle. A license is sold monthly but always expires at 00:00 Asia/Ho_Chi_Minh
# on the anchor day, so the whole fleet renews on the same calendar date. See
# license-expiry.js and docs/agent/CONFIG_SCHEMA_V2_PROPOSAL.md section 1.6.
LICENSE_BILLING_ANCHOR_DAY=16
# Days after expiresAt during which the station still runs and only warns.
LICENSE_GRACE_DAYS=7
# Hours a station may run without reaching this server. Forwarded to the client;
# enforcement needs the offline grant (S5) which is not implemented yet.
LICENSE_OFFLINE_GRACE_HOURS=72
# middleCode IS the DataHub site code, so two licenses sharing a placeholder share a
# tenant and read each other's rows. Rejecting placeholders ("0000", "", "DEFAULT"...)
# is therefore the default and needs no variable: leave this unset in production.
# "0" is the ONLY value that disables it, and it is a migration aid, not a setting —
# a key that still carries a placeholder has not been backfilled yet.
REQUIRE_UNIQUE_SITE_CODE=
