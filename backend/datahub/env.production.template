# Copy to an untracked .env.production on the production VPS. Values and
# backup credentials must be independent from staging.
ASPNETCORE_ENVIRONMENT=Production
DATAHUB_CHANNEL=production
DATAHUB_PUBLIC_HOST=datahub.example.com
TLS_CONTACT_EMAIL=ops@example.com
DATAHUB_API_IMAGE=ghcr.io/replace/autojms-datahub-api@sha256:REPLACE_WITH_64_HEX_IMAGE_DIGEST
POSTGRES_DB=datahub_production
POSTGRES_USER=datahub_production
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATAHUB_DEVICE_TOKEN_ISSUER=autojms-datahub-production
DATAHUB_DEVICE_TOKEN_AUDIENCE=autojms-device-production
DATAHUB_DEVICE_TOKEN_SIGNING_KEY=REPLACE_WITH_32_PLUS_BYTE_SECRET
DATAHUB_ENROLLMENT_PEPPER=REPLACE_WITH_32_PLUS_BYTE_SECRET
DATAHUB_LICENSE_ASSERTION_ISSUER=autojms-license-production
DATAHUB_LICENSE_ASSERTION_AUDIENCE=autojms-datahub-enroll-production
DATAHUB_LICENSE_ASSERTION_VALIDATION_KEY=REPLACE_WITH_PRODUCTION_ISSUER_KEY
DATAHUB_STAGING_TEST_SIGNING_KEY=
DATAHUB_ALLOW_STAGING_TEST_ISSUER=false
