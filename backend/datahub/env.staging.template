# Copy to an untracked .env.staging on the staging VPS. Generate every secret
# independently from production; never commit the resulting file.
ASPNETCORE_ENVIRONMENT=Staging
DATAHUB_CHANNEL=staging
# This is Caddy's site address, and Caddy serves ONLY this host. A request whose
# Host header does not match falls through to Caddy's empty default response --
# HTTP 200 with Content-Length: 0, never reaching the API. That empty 200 is the
# single most misleading symptom in this stack: it looks like a broken proxy, and
# a health probe sent to a non-matching host reports a false result either way.
# A hostname here gets automatic HTTPS. A bare IP address MUST carry an explicit
# http:// prefix: Caddy does not skip auto-HTTPS for IPs, it issues an internal-CA
# certificate that no client can ever negotiate, because nobody sends SNI for an
# IP literal. The explicit scheme is what disables auto-HTTPS.
DATAHUB_PUBLIC_HOST=datahub-dev.example.com
# Must be an address whose DOMAIN RESOLVES. Let's Encrypt does a DNS check on the
# contact address, so a reserved placeholder domain (anything under .invalid,
# .test, .example -- RFC 2606) makes ACME account registration fail and no
# certificate is ever issued. A mailbox need not exist; the domain must resolve.
TLS_CONTACT_EMAIL=ops@example.com
DATAHUB_API_IMAGE=ghcr.io/replace/autojms-datahub-api@sha256:REPLACE_WITH_64_HEX_IMAGE_DIGEST
POSTGRES_DB=datahub_staging
POSTGRES_USER=datahub_staging
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATAHUB_DEVICE_TOKEN_ISSUER=autojms-datahub-staging
DATAHUB_DEVICE_TOKEN_AUDIENCE=autojms-device-staging
DATAHUB_DEVICE_TOKEN_SIGNING_KEY=REPLACE_WITH_32_PLUS_BYTE_SECRET
DATAHUB_ENROLLMENT_PEPPER=REPLACE_WITH_32_PLUS_BYTE_SECRET
DATAHUB_LICENSE_ASSERTION_ISSUER=autojms-license-staging
DATAHUB_LICENSE_ASSERTION_AUDIENCE=autojms-datahub-enroll-staging
DATAHUB_STAGING_TEST_SIGNING_KEY=REPLACE_WITH_32_PLUS_BYTE_SECRET
DATAHUB_ALLOW_STAGING_TEST_ISSUER=true
DATAHUB_LICENSE_ASSERTION_VALIDATION_KEY=
